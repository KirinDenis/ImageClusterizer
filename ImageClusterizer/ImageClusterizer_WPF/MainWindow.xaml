<Window x:Class="ImageClusterizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ImageClusterizer"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:ImageClusterizer.Models"
        mc:Ignorable="d"
        Title="AI :: Image Clusterizer"
        Width="1400" Height="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackground}">

  <DockPanel LastChildFill="True">

    <!-- ============ TOOLBAR ============ -->
    <ToolBar DockPanel.Dock="Top" Height="48" Background="{DynamicResource ToolBarBackground}">
      <Button ToolTip="Scan images folder" Command="{Binding ViewModel.StartScanImagesCommand}" IsEnabled="{Binding ViewModel.IsNotScanning}">
        <StackPanel Orientation="Horizontal"><TextBlock Text="&#x1F4C2;" FontSize="16" Margin="0,0,6,0"/><TextBlock Text="Scan folder" VerticalAlignment="Center"/></StackPanel>
      </Button>
      <Separator/>
      <Button ToolTip="Stop scanning" Command="{Binding ViewModel.CancelScanCommand}" IsEnabled="{Binding ViewModel.IsScanning}">
        <StackPanel Orientation="Horizontal"><TextBlock Text="&#x23F9;" FontSize="16" Margin="0,0,6,0"/><TextBlock Text="Stop" VerticalAlignment="Center"/></StackPanel>
      </Button>
      <Separator/>
      <Button ToolTip="Reload from database" Command="{Binding ViewModel.LoadExistingClustersCommand}" IsEnabled="{Binding ViewModel.IsNotScanning}">
        <StackPanel Orientation="Horizontal"><TextBlock Text="&#x1F504;" FontSize="16" Margin="0,0,6,0"/><TextBlock Text="Reload DB" VerticalAlignment="Center"/></StackPanel>
      </Button>
      <Separator/>
      <TextBlock Text="Vector:" VerticalAlignment="Center" Margin="8,0,4,0" Foreground="{DynamicResource AppText}"/>
      <ComboBox Width="110" VerticalAlignment="Center"
                ItemsSource="{Binding ViewModel.AvailableVectorTypes}"
                SelectedItem="{Binding ViewModel.SelectedVectorType, Mode=TwoWay}"
                IsEnabled="{Binding ViewModel.IsNotScanning}"/>
      <Separator/>
      <Button ToolTip="Clear all data" Command="{Binding ViewModel.ClearAllDataCommand}" IsEnabled="{Binding ViewModel.IsNotScanning}">
        <StackPanel Orientation="Horizontal"><TextBlock Text="&#x1F5D1;" FontSize="16" Margin="0,0,6,0"/><TextBlock Text="Clear data" VerticalAlignment="Center"/></StackPanel>
      </Button>
      <Separator/>
      <Button ToolTip="Advanced settings and telemetry" Command="{Binding ViewModel.ToggleCockpitCommand}">
        <StackPanel Orientation="Horizontal"><TextBlock Text="&#x2699;" FontSize="16" Margin="0,0,4,0"/><TextBlock Text="Advanced" VerticalAlignment="Center"/></StackPanel>
      </Button>
      <Separator/>
      <Button ToolTip="Toggle theme" Command="{Binding ViewModel.ToggleThemeCommand}">
        <TextBlock Text="{Binding ViewModel.ThemeIcon}" FontSize="14"/>
      </Button>
    </ToolBar>

    <!-- ============ STATUS BAR ============ -->
    <DockPanel DockPanel.Dock="Bottom" Height="24" Background="{DynamicResource StatusBarBackground}">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
        <TextBlock Foreground="White" FontSize="11">
          <Run Text="&#x1F5BC; "/><Run Text="{Binding ViewModel.VectorCount, Mode=OneWay}"/>
          <Run Text=" imgs | &#x1F5C2; "/><Run Text="{Binding ViewModel.ClusterCount, Mode=OneWay}"/>
          <Run Text=" clusters | "/><Run Text="{Binding ViewModel.SelectedVectorType, Mode=OneWay}"/>
          <Run Text=" | "/><Run Text="{Binding ViewModel.ZoomText, Mode=OneWay}"/>
          <Run Text=" | Phase: "/><Run Text="{Binding ViewModel.CurrentPhase, Mode=OneWay}"/>
        </TextBlock>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,4,0">
          <Ellipse.Style><Style TargetType="Ellipse">
            <Setter Property="Fill" Value="{DynamicResource IndicatorInactive}"/>
            <Style.Triggers><DataTrigger Binding="{Binding ViewModel.GpuAvailable}" Value="True"><Setter Property="Fill" Value="{DynamicResource IndicatorActive}"/></DataTrigger></Style.Triggers>
          </Style></Ellipse.Style>
        </Ellipse>
        <TextBlock Foreground="White" FontSize="11" Text="{Binding ViewModel.GpuName, Mode=OneWay}" Margin="0,0,12,0"/>
        <TextBlock Foreground="White" FontSize="11"><Run Text="&#x1F4BE; "/><Run Text="{Binding ViewModel.DatabaseSizeText, Mode=OneWay}"/></TextBlock>
      </StackPanel>
    </DockPanel>

    <!-- ============ CONSOLE ============ -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource ConsoleBackground}"
            BorderThickness="0,1,0,0" BorderBrush="{DynamicResource AppBorder}" x:Name="ConsoleBorder">
      <Border.Style><Style TargetType="Border"><Setter Property="Height" Value="24"/>
        <Style.Triggers><DataTrigger Binding="{Binding ViewModel.IsConsoleExpanded}" Value="True"><Setter Property="Height" Value="144"/></DataTrigger></Style.Triggers>
      </Style></Border.Style>
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Height="24" Margin="4,0">
          <Button DockPanel.Dock="Right" Content="Clear" FontSize="10" Command="{Binding ViewModel.ClearConsoleCommand}" Padding="6,0" Margin="4,2"/>
          <Button DockPanel.Dock="Right" FontSize="10" Padding="6,0" Margin="4,2" Command="{Binding ViewModel.ToggleConsoleCommand}">
            <Button.Style><Style TargetType="Button"><Setter Property="Content" Value="&#x25B2;"/>
              <Style.Triggers><DataTrigger Binding="{Binding ViewModel.IsConsoleExpanded}" Value="False"><Setter Property="Content" Value="&#x25BC;"/></DataTrigger></Style.Triggers>
            </Style></Button.Style>
          </Button>
          <TextBlock Text="&#x25B6; Console" FontSize="11" Foreground="{DynamicResource ConsoleForeground}" FontFamily="Consolas" VerticalAlignment="Center"/>
        </DockPanel>
        <ScrollViewer x:Name="ConsoleScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                      Visibility="{Binding ViewModel.IsConsoleExpanded, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
          <ItemsControl ItemsSource="{Binding ViewModel.ConsoleLines, Mode=OneWay}"
                        FontFamily="Consolas" FontSize="11"
                        Foreground="{DynamicResource ConsoleForeground}"
                        Background="{DynamicResource ConsoleBackground}"
                        Padding="4,2"/>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- ============ COCKPIT ============ -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource CockpitBackground}"
            BorderThickness="0,0,0,1" BorderBrush="{DynamicResource AppBorder}">
      <Border.Style><Style TargetType="Border"><Setter Property="Height" Value="0"/><Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers><DataTrigger Binding="{Binding ViewModel.IsCockpitExpanded}" Value="True"><Setter Property="Height" Value="Auto"/><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
      </Style></Border.Style>
      <Grid Margin="12,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="180"/>
          <ColumnDefinition Width="2.2*"/>
        </Grid.ColumnDefinitions>

        <!-- Col 0: Hardware -->
        <Border Grid.Column="0" Margin="4" Padding="8" BorderBrush="{DynamicResource CockpitGroupBorder}" BorderThickness="1" CornerRadius="4">
          <StackPanel>
            <TextBlock Text="Hardware" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AppText}" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
              <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,6,0">
                <Ellipse.Style><Style TargetType="Ellipse">
                  <Setter Property="Fill" Value="{DynamicResource IndicatorInactive}"/>
                  <Style.Triggers><DataTrigger Binding="{Binding ViewModel.GpuAvailable}" Value="True"><Setter Property="Fill" Value="{DynamicResource IndicatorActive}"/></DataTrigger></Style.Triggers>
                </Style></Ellipse.Style>
              </Ellipse>
              <TextBlock Text="{Binding ViewModel.GpuName, Mode=OneWay}" FontSize="11" Foreground="{DynamicResource AppText}" VerticalAlignment="Center"/>
            </StackPanel>
            <CheckBox Content="Use GPU" IsChecked="{Binding ViewModel.UseGpu, Mode=TwoWay}" IsEnabled="{Binding ViewModel.GpuAvailable}" Foreground="{DynamicResource AppText}" FontSize="11"/>
            <TextBlock FontSize="10" Foreground="{DynamicResource AppTextSecondary}" Margin="0,4,0,0"><Run Text="DB: "/><Run Text="{Binding ViewModel.DatabaseSizeText, Mode=OneWay}"/></TextBlock>
          </StackPanel>
        </Border>

        <!-- Col 1: Vector Compression -->
        <Border Grid.Column="1" Margin="4" Padding="8" BorderBrush="{DynamicResource CockpitGroupBorder}" BorderThickness="1" CornerRadius="4">
          <StackPanel>
            <TextBlock Text="Vector Compression" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AppText}" Margin="0,0,0,6"/>
            <Slider Minimum="8" Maximum="2048" Value="{Binding ViewModel.SparseTopN, Mode=TwoWay}" SmallChange="1" LargeChange="256"/>
            <TextBlock FontSize="11" Foreground="{DynamicResource AppText}" Margin="0,4,0,0">
              <Run Text="Top-"/><Run Text="{Binding ViewModel.SparseTopN, Mode=OneWay}"/><Run Text=" / 2048"/>
            </TextBlock>
            <TextBlock FontSize="10" Foreground="{DynamicResource AppTextSecondary}" Margin="0,4,0,0"><Run Text="Last scan: "/><Run Text="{Binding ViewModel.LastScanDuration, Mode=OneWay}"/></TextBlock>
          </StackPanel>
        </Border>

        <!-- Col 2: Clustering -->
        <Border Grid.Column="2" Margin="4" Padding="8" BorderBrush="{DynamicResource CockpitGroupBorder}" BorderThickness="1" CornerRadius="4">
          <StackPanel>
            <TextBlock Text="Clustering" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AppText}" Margin="0,0,0,6"/>
            <Slider Minimum="0.50" Maximum="0.99" SmallChange="0.01" Value="{Binding ViewModel.SimilarityThreshold, Mode=TwoWay}"/>
            <TextBlock FontSize="11" Foreground="{DynamicResource AppText}" Margin="0,4,0,0">
              <Run Text="Threshold: "/><Run Text="{Binding ViewModel.SimilarityThreshold, Mode=OneWay, StringFormat=F2}"/>
            </TextBlock>
            <TextBlock FontSize="10" Foreground="{DynamicResource AppTextSecondary}" Margin="0,4,0,0" Text="{Binding ViewModel.ClusteringStatus, Mode=OneWay}"/>
          </StackPanel>
        </Border>

        <!-- Col 3: Analysis Profiles -->
        <Border Grid.Column="3" Margin="4" Padding="8" BorderBrush="{DynamicResource AppAccent}" BorderThickness="1" CornerRadius="4">
          <StackPanel>
            <TextBlock Text="Profiles" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AppAccent}" Margin="0,0,0,6"/>
            <ComboBox FontSize="11" Margin="0,0,0,4"
                      ItemsSource="{Binding ViewModel.Profiles, Mode=OneWay}"
                      SelectedItem="{Binding ViewModel.SelectedProfile, Mode=TwoWay}"
                      DisplayMemberPath="Name"/>
            <TextBox FontSize="11" Margin="0,0,0,4" Padding="3,2"
                     Text="{Binding ViewModel.NewProfileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="New profile name"/>
            <StackPanel Orientation="Horizontal">
              <Button Content="+ Create" FontSize="10" Padding="5,2" Margin="0,0,3,0" Command="{Binding ViewModel.CreateProfileCommand}"/>
              <Button Content="Save" FontSize="10" Padding="5,2" Margin="0,0,3,0" Command="{Binding ViewModel.SaveCurrentProfileCommand}"/>
              <Button Content="Del" FontSize="10" Padding="5,2"
                      Command="{Binding ViewModel.DeleteProfileCommand}"
                      IsEnabled="{Binding ViewModel.CanDeleteProfile, Mode=OneWay}"
                      ToolTip="Delete selected profile (cannot delete Default)"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Col 4: Live Telemetry -->
        <Border Grid.Column="4" Margin="4" Padding="12" BorderBrush="{DynamicResource AppAccent}" BorderThickness="2" CornerRadius="6" Background="{DynamicResource AppBackground}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Stats -->
            <StackPanel Grid.Column="0">
              <TextBlock Text="LIVE TELEMETRY" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AppAccent}" Margin="0,0,0,6"/>
              <TextBlock FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AppText}">
                <Run Text="&#x1F5BC; "/><Run Text="{Binding ViewModel.VectorCount, Mode=OneWay}"/><Run Text=" images"/>
              </TextBlock>
              <TextBlock FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AppText}" Margin="0,3">
                <Run Text="&#x1F5C2; "/><Run Text="{Binding ViewModel.ClusterCount, Mode=OneWay}"/><Run Text=" clusters"/>
              </TextBlock>
              <TextBlock FontSize="11" Foreground="{DynamicResource AppTextSecondary}" Margin="0,2">
                <Run Text="DB: "/><Run Text="{Binding ViewModel.DatabaseSizeText, Mode=OneWay}"/>
              </TextBlock>
            </StackPanel>

            <!-- Phase Indicators -->
            <StackPanel Grid.Column="1" Margin="6,0,0,0">
              <TextBlock Text="PHASES" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AppAccent}" Margin="0,0,0,6"/>
              <!-- Scan -->
              <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <Ellipse Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,5,0">
                  <Ellipse.Style><Style TargetType="Ellipse">
                    <Setter Property="Fill" Value="#555555"/>
                    <Style.Triggers><DataTrigger Binding="{Binding ViewModel.IsScanPhaseActive}" Value="True"><Setter Property="Fill" Value="#00C853"/></DataTrigger></Style.Triggers>
                  </Style></Ellipse.Style>
                </Ellipse>
                <TextBlock FontSize="11" VerticalAlignment="Center">
                  <TextBlock.Style><Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#555555"/>
                    <Style.Triggers><DataTrigger Binding="{Binding ViewModel.IsScanPhaseActive}" Value="True"><Setter Property="Foreground" Value="#00C853"/></DataTrigger></Style.Triggers>
                  </Style></TextBlock.Style>
                  <Run Text="Scan"/>
                </TextBlock>
              </StackPanel>
              <!-- PCA -->
              <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <Ellipse Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,5,0">
                  <Ellipse.Style><Style TargetType="Ellipse">
                    <Setter Property="Fill" Value="#555555"/>
                    <Style.Triggers><DataTrigger Binding="{Binding ViewModel.IsPcaPhaseActive}" Value="True"><Setter Property="Fill" Value="#FF9100"/></DataTrigger></Style.Triggers>
                  </Style></Ellipse.Style>
                </Ellipse>
                <TextBlock FontSize="11" VerticalAlignment="Center">
                  <TextBlock.Style><Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#555555"/>
                    <Style.Triggers><DataTrigger Binding="{Binding ViewModel.IsPcaPhaseActive}" Value="True"><Setter Property="Foreground" Value="#FF9100"/></DataTrigger></Style.Triggers>
                  </Style></TextBlock.Style>
                  <Run Text="PCA / RSVD"/>
                </TextBlock>
              </StackPanel>
              <!-- Render -->
              <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <Ellipse Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,5,0">
                  <Ellipse.Style><Style TargetType="Ellipse">
                    <Setter Property="Fill" Value="#555555"/>
                    <Style.Triggers><DataTrigger Binding="{Binding ViewModel.IsRenderPhaseActive}" Value="True"><Setter Property="Fill" Value="#40C4FF"/></DataTrigger></Style.Triggers>
                  </Style></Ellipse.Style>
                </Ellipse>
                <TextBlock FontSize="11" VerticalAlignment="Center">
                  <TextBlock.Style><Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#555555"/>
                    <Style.Triggers><DataTrigger Binding="{Binding ViewModel.IsRenderPhaseActive}" Value="True"><Setter Property="Foreground" Value="#40C4FF"/></DataTrigger></Style.Triggers>
                  </Style></TextBlock.Style>
                  <Run Text="Render"/>
                </TextBlock>
              </StackPanel>
              <!-- Cluster -->
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,5,0">
                  <Ellipse.Style><Style TargetType="Ellipse">
                    <Setter Property="Fill" Value="#555555"/>
                    <Style.Triggers><DataTrigger Binding="{Binding ViewModel.IsClusterPhaseActive}" Value="True"><Setter Property="Fill" Value="#E040FB"/></DataTrigger></Style.Triggers>
                  </Style></Ellipse.Style>
                </Ellipse>
                <TextBlock FontSize="11" VerticalAlignment="Center">
                  <TextBlock.Style><Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#555555"/>
                    <Style.Triggers><DataTrigger Binding="{Binding ViewModel.IsClusterPhaseActive}" Value="True"><Setter Property="Foreground" Value="#E040FB"/></DataTrigger></Style.Triggers>
                  </Style></TextBlock.Style>
                  <Run Text="Cluster"/>
                </TextBlock>
              </StackPanel>
            </StackPanel>

            <!-- Timing -->
            <StackPanel Grid.Column="2" Margin="6,0,0,0">
              <TextBlock Text="PROCESSING" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AppAccent}" Margin="0,0,0,6"/>
              <TextBlock FontSize="11" Foreground="{DynamicResource AppText}"><Run Text="Phase: "/><Run Text="{Binding ViewModel.CurrentPhase, Mode=OneWay}"/></TextBlock>
              <TextBlock FontSize="11" Foreground="{DynamicResource AppText}" Margin="0,3"><Run Text="Elapsed: "/><Run Text="{Binding ViewModel.ElapsedText, Mode=OneWay}"/></TextBlock>
              <TextBlock FontSize="11" Foreground="{DynamicResource AppText}" Margin="0,2"><Run Text="ETA: "/><Run Text="{Binding ViewModel.EtaText, Mode=OneWay}"/></TextBlock>
              <TextBlock FontSize="11" Foreground="{DynamicResource AppText}" Margin="0,2"><Run Text="Speed: "/><Run Text="{Binding ViewModel.ItemsPerSecond, Mode=OneWay}"/><Run Text=" /s"/></TextBlock>
              <ProgressBar Value="{Binding ViewModel.PcaProgress, Mode=OneWay}" Maximum="100"
                           Height="8" Margin="0,6,0,0" Foreground="{DynamicResource AppAccent}">
                <ProgressBar.Style><Style TargetType="ProgressBar"><Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers><DataTrigger Binding="{Binding ViewModel.IsPcaComputing}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                </Style></ProgressBar.Style>
              </ProgressBar>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Border>

    <!-- ============ SCAN PROGRESS ============ -->
    <Border DockPanel.Dock="Top" Visibility="{Binding ViewModel.ProgressVisibility, Mode=OneWay}"
            Background="{DynamicResource AppSurface}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource AppBorder}" Padding="12,6">
      <StackPanel>
        <TextBlock Margin="0,0,0,3" Foreground="{DynamicResource AppText}" FontSize="11">
          <Run Text="Processing: "/><Run Text="{Binding ViewModel.CurrentFile, Mode=OneWay}"/>
          <Run Text=" "/><Run Text="{Binding ViewModel.ProcessedCountText, Mode=OneWay}"/>
          <Run Text=" / "/><Run Text="{Binding ViewModel.TotalCountText, Mode=OneWay}"/>
        </TextBlock>
        <ProgressBar Value="{Binding ViewModel.Progress, Mode=OneWay}" Maximum="100" Height="6" Foreground="{DynamicResource AppAccent}"/>
      </StackPanel>
    </Border>

    <!-- ============ TABS ============ -->
    <TabControl Background="{DynamicResource AppBackground}">

      <!-- MAP TAB -->
      <TabItem Header="&#x1F5FA; Map">
        <Grid>
          <DockPanel Height="36" VerticalAlignment="Top" Background="{DynamicResource AppSurface}" Panel.ZIndex="10" LastChildFill="False">
            <Border DockPanel.Dock="Bottom" Height="1" Background="{DynamicResource AppBorder}"/>
            <Button Content="&#x27F3; Recalculate PCA" Command="{Binding ViewModel.RecalculatePcaCommand}" Margin="8,4" Padding="8,3" DockPanel.Dock="Left"/>
            <Button Content="+" x:Name="BtnZoomIn" Margin="4,4" Padding="10,1" DockPanel.Dock="Left" FontSize="18" FontWeight="Bold" ToolTip="Zoom in" Click="BtnZoomIn_Click"/>
            <Button Content="-" x:Name="BtnZoomOut" Margin="2,4" Padding="10,1" DockPanel.Dock="Left" FontSize="18" FontWeight="Bold" ToolTip="Zoom out" Click="BtnZoomOut_Click"/>
            <Button Content="1:1" x:Name="BtnZoomReset" Margin="2,4" Padding="8,3" DockPanel.Dock="Left" ToolTip="Reset zoom" Click="BtnZoomReset_Click"/>
            <TextBlock Text=" Wheel=Zoom  Drag=Pan  Click=Explorer  Shift+Click=Cycle Z"
                       VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource AppTextSecondary}"
                       DockPanel.Dock="Left" Margin="8,0"/>
            <ProgressBar IsIndeterminate="True" Width="120" Height="14" Margin="0,0,4,0"
                         VerticalAlignment="Center" Foreground="{DynamicResource AppAccent}" DockPanel.Dock="Right">
              <ProgressBar.Style><Style TargetType="ProgressBar"><Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers><DataTrigger Binding="{Binding ViewModel.IsPcaComputing}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
              </Style></ProgressBar.Style>
            </ProgressBar>
            <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource AppTextSecondary}" DockPanel.Dock="Right" Margin="0,0,4,0">
              <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers><DataTrigger Binding="{Binding ViewModel.IsPcaComputing}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
              </Style></TextBlock.Style>
              <Run Text="RSVD "/><Run Text="{Binding ViewModel.PcaProgress, Mode=OneWay}"/><Run Text="%"/>
            </TextBlock>
          </DockPanel>
          <local:MapRenderCanvas x:Name="MapCanvas" Margin="0,36,0,0"
              Background="{DynamicResource AppBackground}"
              Items="{Binding ViewModel.MapDots}"
              MouseWheel="MapViewport_MouseWheel"
              MouseLeftButtonDown="MapViewport_MouseLeftButtonDown"
              MouseLeftButtonUp="MapViewport_MouseLeftButtonUp"
              MouseMove="MapViewport_MouseMove"
              MouseRightButtonDown="MapViewport_MouseRightButtonDown"
              Cursor="Hand"/>
          <Border x:Name="HoverPanel" Visibility="Collapsed" Width="192"
                  VerticalAlignment="Top" HorizontalAlignment="Left"
                  Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource AppBorder}"
                  BorderThickness="1" CornerRadius="8" Padding="8"
                  Panel.ZIndex="100" IsHitTestVisible="False" Margin="0,36,0,0">
            <Border.Effect><DropShadowEffect Color="Black" Opacity="0.45" BlurRadius="18" ShadowDepth="6" Direction="310"/></Border.Effect>
            <StackPanel>
              <Image x:Name="HoverImage" Width="176" Height="176" Stretch="Uniform" Margin="0,0,0,8" RenderOptions.BitmapScalingMode="HighQuality"/>
              <TextBlock x:Name="HoverFileName" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppText}" TextWrapping="Wrap" MaxWidth="176"/>
              <TextBlock x:Name="HoverFileSize" FontSize="10" Foreground="{DynamicResource AppTextSecondary}" Margin="0,2,0,0"/>
              <TextBlock Text="Click = open in Explorer" FontSize="9" FontStyle="Italic" Foreground="{DynamicResource AppTextSecondary}" Margin="0,6,0,0"/>
              <TextBlock Text="Shift+Click = cycle Z-order" FontSize="9" FontStyle="Italic" Foreground="{DynamicResource AppTextSecondary}"/>
            </StackPanel>
          </Border>
        </Grid>
      </TabItem>

      <!-- CLUSTERS TAB -->
      <TabItem>
        <TabItem.Header>
          <TextBlock><Run Text="&#x1F517; Clusters ("/><Run Text="{Binding ViewModel.ClusterCount, Mode=OneWay}"/><Run Text=")"/></TextBlock>
        </TabItem.Header>
        <DockPanel>
          <Border DockPanel.Dock="Top" Background="{DynamicResource AppSurface}"
                  BorderThickness="0,0,0,1" BorderBrush="{DynamicResource AppBorder}" Padding="8,4">
            <StackPanel Orientation="Horizontal">
              <Button Content="&#x25B6; Compute clusters" Command="{Binding ViewModel.ComputeClustersCommand}" Margin="0,0,12,0" Padding="8,3"/>
              <ProgressBar IsIndeterminate="True" Width="120" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource AppAccent}">
                <ProgressBar.Style><Style TargetType="ProgressBar"><Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers><DataTrigger Binding="{Binding ViewModel.IsClusterComputing}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                </Style></ProgressBar.Style>
              </ProgressBar>
              <TextBlock Text="Computing..." VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource AppTextSecondary}">
                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers><DataTrigger Binding="{Binding ViewModel.IsClusterComputing}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                </Style></TextBlock.Style>
              </TextBlock>
            </StackPanel>
          </Border>
          <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                     FontSize="16" Foreground="{DynamicResource AppTextSecondary}" TextAlignment="Center">
            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers><DataTrigger Binding="{Binding ViewModel.ClusterCount}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
            </Style></TextBlock.Style>
            <Run Text="&#x1F517;&#xA;No clusters yet. Click Compute clusters."/>
          </TextBlock>
          <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource AppBackground}">
            <ItemsControl ItemsSource="{Binding ViewModel.Clusters, Mode=OneWay}" Margin="12">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type models:ImageCluster}">
                  <Border BorderBrush="{DynamicResource AppBorder}" Background="{DynamicResource AppSurface}"
                          BorderThickness="1" CornerRadius="6" Padding="10" Width="280" Margin="6" VerticalAlignment="Top">
                    <StackPanel>
                      <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AppText}" Margin="0,0,0,2">
                        <Run Text="Cluster #"/><Run Text="{Binding ClusterId, Mode=OneWay}"/>
                      </TextBlock>
                      <TextBlock FontSize="11" Margin="0,0,0,6" Foreground="{DynamicResource AppTextSecondary}">
                        <Run Text="{Binding Images.Count, Mode=OneWay}"/><Run Text=" images"/>
                      </TextBlock>
                      <ItemsControl ItemsSource="{Binding Images, Mode=OneWay}" MaxHeight="180">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="{x:Type models:ImageVector}">
                            <Image Source="{Binding ThumbnailPath, Mode=OneWay}" Width="72" Height="72"
                                   Stretch="UniformToFill" Margin="2" ToolTip="{Binding FilePath, Mode=OneWay}"/>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </TabItem>

    </TabControl>
  </DockPanel>
</Window>
