<Window x:Class="ImageClusterizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ImageClusterizer"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:ImageClusterizer.Models"
        mc:Ignorable="d"
        Title="AI :: Image Clusterizer"
        Width="1400" Height="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackground}">

    <DockPanel LastChildFill="True">

        <!-- ===== TOOLBAR ===== -->
        <ToolBar DockPanel.Dock="Top" Height="48" Background="{DynamicResource ToolBarBackground}">
            <Button ToolTip="Select folder and scan images"
                    Command="{Binding ViewModel.StartScanImagesCommand}"
                    IsEnabled="{Binding ViewModel.IsNotScanning}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x1F4C2;" FontSize="16" Margin="0,0,6,0"/>
                    <TextBlock Text="Scan folder" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Separator/>
            <Button ToolTip="Stop scanning"
                    Command="{Binding ViewModel.CancelScanCommand}"
                    IsEnabled="{Binding ViewModel.IsScanning}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x23F9;" FontSize="16" Margin="0,0,6,0"/>
                    <TextBlock Text="Stop" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Separator/>
            <Button ToolTip="Reload existing vectors from database"
                    Command="{Binding ViewModel.LoadExistingClustersCommand}"
                    IsEnabled="{Binding ViewModel.IsNotScanning}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x1F504;" FontSize="16" Margin="0,0,6,0"/>
                    <TextBlock Text="Reload DB" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Separator/>
            <TextBlock Text="Vector:" VerticalAlignment="Center" Margin="8,0,4,0" Foreground="{DynamicResource AppText}"/>
            <ComboBox Width="110" VerticalAlignment="Center"
                      ItemsSource="{Binding ViewModel.AvailableVectorTypes}"
                      SelectedItem="{Binding ViewModel.SelectedVectorType, Mode=TwoWay}"
                      IsEnabled="{Binding ViewModel.IsNotScanning}"
                      ToolTip="Embedding (2048D) - better similarity. Logit (1000D) - classification output."/>
            <Separator/>
            <Button ToolTip="Delete all stored vectors, thumbnails and cached data"
                    Command="{Binding ViewModel.ClearAllDataCommand}"
                    IsEnabled="{Binding ViewModel.IsNotScanning}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x1F5D1;" FontSize="16" Margin="0,0,6,0"/>
                    <TextBlock Text="Clear data" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Separator/>
            <Button ToolTip="Toggle advanced settings panel"
                    Command="{Binding ViewModel.ToggleCockpitCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x2699;" FontSize="16" Margin="0,0,4,0"/>
                    <TextBlock Text="Advanced" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Separator/>
            <Button ToolTip="Toggle dark/light theme"
                    Command="{Binding ViewModel.ToggleThemeCommand}">
                <TextBlock Text="{Binding ViewModel.ThemeIcon}" FontSize="14"/>
            </Button>
        </ToolBar>

        <!-- ===== STATUS BAR ===== -->
        <DockPanel DockPanel.Dock="Bottom" Height="24" Background="{DynamicResource StatusBarBackground}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                <TextBlock Foreground="White" FontSize="11" VerticalAlignment="Center">
                    <Run Text="&#x1F5BC; "/>
                    <Run Text="{Binding ViewModel.VectorCount, Mode=OneWay}"/>
                    <Run Text=" images | "/>
                    <Run Text="&#x1F5C2; "/>
                    <Run Text="{Binding ViewModel.ClusterCount, Mode=OneWay}"/>
                    <Run Text=" clusters | "/>
                    <Run Text="{Binding ViewModel.SelectedVectorType, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,4,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource IndicatorInactive}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ViewModel.GpuAvailable}" Value="True">
                                    <Setter Property="Fill" Value="{DynamicResource IndicatorActive}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Foreground="White" FontSize="11" VerticalAlignment="Center"
                           Text="{Binding ViewModel.GpuName, Mode=OneWay}" Margin="0,0,12,0"/>
                <TextBlock Foreground="White" FontSize="11" VerticalAlignment="Center">
                    <Run Text="&#x1F4BE; "/>
                    <Run Text="{Binding ViewModel.DatabaseSizeText, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>
        </DockPanel>

        <!-- ===== CONSOLE LOG PANEL ===== -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource ConsoleBackground}"
                BorderThickness="0,1,0,0" BorderBrush="{DynamicResource AppBorder}"
                x:Name="ConsoleBorder">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Height" Value="24"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ViewModel.IsConsoleExpanded}" Value="True">
                            <Setter Property="Height" Value="144"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Height="24" Margin="4,0">
                    <Button DockPanel.Dock="Right" Content="Clear" FontSize="10"
                            Command="{Binding ViewModel.ClearConsoleCommand}" Padding="6,0" Margin="4,2"/>
                    <Button DockPanel.Dock="Right" FontSize="10" Padding="6,0" Margin="4,2"
                            Command="{Binding ViewModel.ToggleConsoleCommand}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Content" Value="&#x25B2;"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ViewModel.IsConsoleExpanded}" Value="False">
                                        <Setter Property="Content" Value="&#x25BC;"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <TextBlock Text="&#x25B6; Console" FontSize="11"
                               Foreground="{DynamicResource ConsoleForeground}"
                               FontFamily="Consolas" VerticalAlignment="Center"/>
                </DockPanel>
                <ScrollViewer x:Name="ConsoleScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              Visibility="{Binding ViewModel.IsConsoleExpanded, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
                    <ItemsControl ItemsSource="{Binding ViewModel.ConsoleLines, Mode=OneWay}"
                                  FontFamily="Consolas" FontSize="11"
                                  Foreground="{DynamicResource ConsoleForeground}"
                                  Background="{DynamicResource ConsoleBackground}"
                                  Padding="4,2"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===== COCKPIT ADVANCED SETTINGS PANEL ===== -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource CockpitBackground}"
                BorderThickness="0,0,0,1" BorderBrush="{DynamicResource AppBorder}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Height" Value="0"/>
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ViewModel.IsCockpitExpanded}" Value="True">
                            <Setter Property="Height" Value="Auto"/>
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid Margin="12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Margin="4" Padding="8"
                        BorderBrush="{DynamicResource CockpitGroupBorder}" BorderThickness="1" CornerRadius="4">
                    <StackPanel>
                        <TextBlock Text="Compute Hardware" FontWeight="Bold" FontSize="11"
                                   Foreground="{DynamicResource AppText}" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource IndicatorInactive}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ViewModel.GpuAvailable}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource IndicatorActive}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding ViewModel.GpuName, Mode=OneWay}" FontSize="11"
                                       Foreground="{DynamicResource AppText}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <CheckBox Content="Use GPU" IsChecked="{Binding ViewModel.UseGpu, Mode=TwoWay}"
                                  IsEnabled="{Binding ViewModel.GpuAvailable}"
                                  Foreground="{DynamicResource AppText}" FontSize="11" Margin="0,2"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="Threads: " FontSize="11" Foreground="{DynamicResource AppTextSecondary}" VerticalAlignment="Center"/>
                            <TextBlock FontSize="11" Foreground="{DynamicResource AppText}" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding ViewModel.ThreadCount}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ViewModel.ThreadCount}" Value="0">
                                                <Setter Property="Text" Value="Auto"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Margin="4" Padding="8"
                        BorderBrush="{DynamicResource CockpitGroupBorder}" BorderThickness="1" CornerRadius="4">
                    <StackPanel>
                        <TextBlock Text="Vector Compression" FontWeight="Bold" FontSize="11"
                                   Foreground="{DynamicResource AppText}" Margin="0,0,0,6"/>
                        <Slider Minimum="8" Maximum="2048"
                                Value="{Binding ViewModel.SparseTopN, Mode=TwoWay}"
                                SmallChange="1" LargeChange="256"
                                ToolTip="Lower = faster PCA, higher = better accuracy"/>
                        <TextBlock FontSize="11" Foreground="{DynamicResource AppText}" Margin="0,4,0,2">
                            <Run Text="Top-"/>
                            <Run Text="{Binding ViewModel.SparseTopN, Mode=OneWay}"/>
                            <Run Text=" / 2048"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Margin="4" Padding="8"
                        BorderBrush="{DynamicResource CockpitGroupBorder}" BorderThickness="1" CornerRadius="4">
                    <StackPanel>
                        <TextBlock Text="Clustering" FontWeight="Bold" FontSize="11"
                                   Foreground="{DynamicResource AppText}" Margin="0,0,0,6"/>
                        <Slider Minimum="0.50" Maximum="0.99" SmallChange="0.01" LargeChange="0.1"
                                Value="{Binding ViewModel.SimilarityThreshold, Mode=TwoWay}"
                                ToolTip="Higher = stricter grouping (more clusters)"/>
                        <TextBlock FontSize="11" Foreground="{DynamicResource AppText}" Margin="0,4,0,2">
                            <Run Text="Threshold: "/>
                            <Run Text="{Binding ViewModel.SimilarityThreshold, Mode=OneWay, StringFormat=F2}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Margin="4" Padding="8"
                        BorderBrush="{DynamicResource CockpitGroupBorder}" BorderThickness="1" CornerRadius="4">
                    <StackPanel>
                        <TextBlock Text="Live Telemetry" FontWeight="Bold" FontSize="11"
                                   Foreground="{DynamicResource AppText}" Margin="0,0,0,6"/>
                        <TextBlock FontSize="11" Foreground="{DynamicResource AppText}">
                            <Run Text="&#x1F5BC; Images: "/>
                            <Run Text="{Binding ViewModel.VectorCount, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock FontSize="11" Foreground="{DynamicResource AppText}">
                            <Run Text="&#x1F5C2; Clusters: "/>
                            <Run Text="{Binding ViewModel.ClusterCount, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock FontSize="11" Foreground="{DynamicResource AppText}">
                            <Run Text="&#x1F4BE; DB: "/>
                            <Run Text="{Binding ViewModel.DatabaseSizeText, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock FontSize="11" Foreground="{DynamicResource AppText}">
                            <Run Text="&#x23F1; Scan: "/>
                            <Run Text="{Binding ViewModel.LastScanDuration, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ===== SCAN PROGRESS PANEL ===== -->
        <Border DockPanel.Dock="Top"
                Visibility="{Binding ViewModel.ProgressVisibility, Mode=OneWay}"
                Background="{DynamicResource AppSurface}"
                BorderThickness="0,0,0,1" BorderBrush="{DynamicResource AppBorder}" Padding="12,6">
            <StackPanel>
                <TextBlock Margin="0,0,0,3" Foreground="{DynamicResource AppText}" FontSize="11">
                    <Run Text="Processing: "/>
                    <Run Text="{Binding ViewModel.CurrentFile, Mode=OneWay}"/>
                    <Run Text="  "/>
                    <Run Text="{Binding ViewModel.ProcessedCountText, Mode=OneWay}"/>
                    <Run Text=" / "/>
                    <Run Text="{Binding ViewModel.TotalCountText, Mode=OneWay}"/>
                </TextBlock>
                <ProgressBar Value="{Binding ViewModel.Progress, Mode=OneWay}" Maximum="100"
                             Height="6" Foreground="{DynamicResource AppAccent}"/>
            </StackPanel>
        </Border>

        <!-- ===== MAIN CONTENT TABS ===== -->
        <TabControl Background="{DynamicResource AppBackground}">

            <!-- TAB 1: MAP with Zoom + Pan + Variable dot sizes -->
            <TabItem Header="&#x1F5FA; Map">
                <Grid>
                    <!-- Map toolbar -->
                    <DockPanel Height="36" VerticalAlignment="Top" Background="{DynamicResource AppSurface}" Panel.ZIndex="1"
                               LastChildFill="False">
                        <Border DockPanel.Dock="Bottom" Height="1" Background="{DynamicResource AppBorder}"/>
                        <Button Content="&#x27F3; Recalculate PCA"
                                Command="{Binding ViewModel.RecalculatePcaCommand}"
                                Margin="8,4" Padding="8,3" DockPanel.Dock="Left"/>
                        <Button Content="+" x:Name="BtnZoomIn"
                                Margin="4,4" Padding="10,3" DockPanel.Dock="Left"
                                FontSize="16" FontWeight="Bold"
                                ToolTip="Zoom in (or use mouse wheel)"
                                Click="BtnZoomIn_Click"/>
                        <Button Content="-" x:Name="BtnZoomOut"
                                Margin="4,4" Padding="10,3" DockPanel.Dock="Left"
                                FontSize="16" FontWeight="Bold"
                                ToolTip="Zoom out"
                                Click="BtnZoomOut_Click"/>
                        <Button Content="Reset" x:Name="BtnZoomReset"
                                Margin="4,4" Padding="8,3" DockPanel.Dock="Left"
                                ToolTip="Reset zoom and pan"
                                Click="BtnZoomReset_Click"/>
                        <TextBlock Text="  Wheel=Zoom  |  Drag=Pan  |  Click=Open in Explorer  |  Shift+Click=Next image below"
                                   VerticalAlignment="Center" FontSize="10"
                                   Foreground="{DynamicResource AppTextSecondary}"
                                   DockPanel.Dock="Left" Margin="8,0"/>
                        <ProgressBar IsIndeterminate="True" Width="120" Height="14"
                                     Margin="0,0,8,0" VerticalAlignment="Center"
                                     Foreground="{DynamicResource AppAccent}"
                                     DockPanel.Dock="Right">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ViewModel.IsPcaComputing}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>
                        <TextBlock VerticalAlignment="Center" FontSize="11"
                                   Foreground="{DynamicResource AppTextSecondary}"
                                   DockPanel.Dock="Right" Margin="0,0,4,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ViewModel.IsPcaComputing}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                            <Run Text="RSVD "/>
                            <Run Text="{Binding ViewModel.PcaProgress, Mode=OneWay}"/>
                            <Run Text="%"/>
                        </TextBlock>
                    </DockPanel>

                    <!-- Map canvas viewport -->
                    <Border x:Name="MapViewport"
                            Margin="0,36,0,0"
                            ClipToBounds="True"
                            Background="{DynamicResource AppBackground}"
                            MouseWheel="MapViewport_MouseWheel"
                            MouseLeftButtonDown="MapViewport_MouseLeftButtonDown"
                            MouseLeftButtonUp="MapViewport_MouseLeftButtonUp"
                            MouseMove="MapViewport_MouseMove"
                            MouseRightButtonDown="MapViewport_MouseRightButtonDown"
                            Cursor="Grab">
                        <Canvas x:Name="MapCanvas"
                                Width="{Binding ViewModel.CanvasWidth}"
                                Height="{Binding ViewModel.CanvasHeight}">
                            <Canvas.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="MapScale" ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform x:Name="MapTranslate" X="0" Y="0"/>
                                </TransformGroup>
                            </Canvas.RenderTransform>

                            <!-- Image dots -->
                            <ItemsControl x:Name="ImageDots"
                                          ItemsSource="{Binding ViewModel.ImageItems, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:ImageVisualItem}">
                                        <Border Width="{Binding DotRadius, Converter={x:Static local:DoubleToSizeConverter.Instance}}"
                                                Height="{Binding DotRadius, Converter={x:Static local:DoubleToSizeConverter.Instance}}"
                                                CornerRadius="{Binding DotRadius, Converter={x:Static local:DoubleToCornerRadiusConverter.Instance}}"
                                                BorderBrush="{DynamicResource AppBorder}"
                                                BorderThickness="1"
                                                Cursor="Hand"
                                                MouseEnter="Dot_MouseEnter"
                                                MouseLeave="Dot_MouseLeave"
                                                MouseLeftButtonDown="Dot_MouseLeftButtonDown"
                                                Tag="{Binding}">
                                            <Border.RenderTransform>
                                                <TranslateTransform
                                                    X="{Binding DotRadius, Converter={x:Static local:NegativeHalfConverter.Instance}}"
                                                    Y="{Binding DotRadius, Converter={x:Static local:NegativeHalfConverter.Instance}}"/>
                                            </Border.RenderTransform>
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding ThumbnailPath}" Stretch="UniformToFill"/>
                                            </Border.Background>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Cluster centroids -->
                            <ItemsControl ItemsSource="{Binding ViewModel.ClusterItems, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:ClusterVisualItem}">
                                        <Grid Width="48" Height="48">
                                            <Ellipse Fill="{DynamicResource AppAccent}" Opacity="0.5"
                                                     Stroke="{DynamicResource AppAccentHover}" StrokeThickness="2"/>
                                            <TextBlock Text="{Binding ClusterId}" FontSize="13" FontWeight="Bold"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Canvas>
                    </Border>

                    <!-- ===== HOVER INFO PANEL ===== -->
                    <Border x:Name="HoverPanel"
                            Visibility="Collapsed"
                            Width="188"
                            VerticalAlignment="Top" HorizontalAlignment="Left"
                            Background="{DynamicResource AppSurface}"
                            BorderBrush="{DynamicResource AppBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8"
                            Panel.ZIndex="100"
                            IsHitTestVisible="False"
                            Margin="0,36,0,0">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" Opacity="0.40" BlurRadius="16"
                                             ShadowDepth="5" Direction="310"/>
                        </Border.Effect>
                        <StackPanel>
                            <Image x:Name="HoverImage"
                                   Width="172" Height="172"
                                   Stretch="Uniform"
                                   Margin="0,0,0,8"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock x:Name="HoverFileName"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppText}"
                                       TextWrapping="Wrap"
                                       MaxWidth="172"/>
                            <TextBlock x:Name="HoverFileSize"
                                       FontSize="10"
                                       Foreground="{DynamicResource AppTextSecondary}"
                                       Margin="0,2,0,0"/>
                            <TextBlock Text="Click to open in Explorer"
                                       FontSize="9"
                                       Foreground="{DynamicResource AppTextSecondary}"
                                       FontStyle="Italic"
                                       Margin="0,6,0,0"/>
                            <TextBlock Text="Shift+Click to cycle Z-order"
                                       FontSize="9"
                                       Foreground="{DynamicResource AppTextSecondary}"
                                       FontStyle="Italic"/>
                        </StackPanel>
                    </Border>

                </Grid>
            </TabItem>

            <!-- TAB 2: CLUSTERS -->
            <TabItem>
                <TabItem.Header>
                    <TextBlock>
                        <Run Text="&#x1F517; Clusters ("/>
                        <Run Text="{Binding ViewModel.ClusterCount, Mode=OneWay}"/>
                        <Run Text=")"/>
                    </TextBlock>
                </TabItem.Header>
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{DynamicResource AppSurface}"
                            BorderThickness="0,0,0,1" BorderBrush="{DynamicResource AppBorder}" Padding="8,4">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="&#x25B6; Compute clusters"
                                    Command="{Binding ViewModel.ComputeClustersCommand}"
                                    Margin="0,0,12,0" Padding="8,3"/>
                            <ProgressBar IsIndeterminate="True" Width="120" Height="16"
                                         Margin="0,0,8,0" VerticalAlignment="Center"
                                         Foreground="{DynamicResource AppAccent}">
                                <ProgressBar.Style>
                                    <Style TargetType="ProgressBar">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ViewModel.IsClusterComputing}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ProgressBar.Style>
                            </ProgressBar>
                            <TextBlock Text="Computing..." VerticalAlignment="Center" FontSize="11"
                                       Foreground="{DynamicResource AppTextSecondary}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ViewModel.IsClusterComputing}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="16" Foreground="{DynamicResource AppTextSecondary}" TextAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ViewModel.ClusterCount}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run Text="&#x1F517;&#xA;"/>
                        <Run Text="No clusters yet. Click Compute clusters."/>
                    </TextBlock>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource AppBackground}">
                        <ItemsControl ItemsSource="{Binding ViewModel.Clusters, Mode=OneWay}" Margin="12">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:ImageCluster}">
                                    <Border BorderBrush="{DynamicResource AppBorder}"
                                            Background="{DynamicResource AppSurface}"
                                            BorderThickness="1" CornerRadius="6"
                                            Padding="10" Width="280" Margin="6" VerticalAlignment="Top">
                                        <StackPanel>
                                            <TextBlock FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AppText}" Margin="0,0,0,2">
                                                <Run Text="Cluster #"/>
                                                <Run Text="{Binding ClusterId}"/>
                                            </TextBlock>
                                            <TextBlock FontSize="11" Margin="0,0,0,6"
                                                       Foreground="{DynamicResource AppTextSecondary}">
                                                <Run Text="{Binding Images.Count}"/>
                                                <Run Text=" images"/>
                                            </TextBlock>
                                            <ItemsControl ItemsSource="{Binding Images}" MaxHeight="180">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type models:ImageVector}">
                                                        <Image Source="{Binding ThumbnailPath}" Width="72" Height="72"
                                                               Stretch="UniformToFill" Margin="2"
                                                               ToolTip="{Binding FilePath}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
        </TabControl>

    </DockPanel>
</Window>
